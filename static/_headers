# Response headers for Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# The page's main Content-Security-Policy is a <meta> tag generated by SvelteKit; browsers
# ignore frame-ancestors in <meta>, so it is sent here as a second, additive policy.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/service-worker.js
  Cache-Control: no-cache
